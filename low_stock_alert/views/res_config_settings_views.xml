<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_stock_low_alert" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.stock.low.alert</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Low stock alerts" name="stock_low_alert_settings">
                    <setting string="Enable low stock alerts" help="Enable or disable automatic reordering rule analysis.">
                        <field name="stock_low_alert_enabled"/>
                    </setting>
                    <setting string="Notification channel" help="Channel used when a responsible rule does not define its own channel." invisible="not stock_low_alert_enabled">
                        <field name="stock_low_alert_notification_mode"/>
                    </setting>
                    <setting string="Resend frequency" help="Minimum time between notifications while the same low stock condition remains." invisible="not stock_low_alert_enabled">
                        <div class="content-group">
                            <field name="stock_low_alert_resend_hours" class="oe_inline"/>
                            <span class="ms-2">hours</span>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
