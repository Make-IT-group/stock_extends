<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_low_alert_exception_list" model="ir.ui.view">
        <field name="name">stock.low.alert.exception.list</field>
        <field name="model">stock.low.alert.exception</field>
        <field name="arch" type="xml">
            <list string="Alert exceptions">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="product_id" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="warehouse_id" optional="show"/>
                <field name="location_id" optional="hide"/>
                <field name="orderpoint_id" optional="hide"/>
                <field name="date_from" optional="hide"/>
                <field name="date_to" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_stock_low_alert_exception_form" model="ir.ui.view">
        <field name="name">stock.low.alert.exception.form</field>
        <field name="model">stock.low.alert.exception</field>
        <field name="arch" type="xml">
            <form string="Alert exception">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Exception scope">
                        <field name="product_id"/>
                        <field name="category_id"/>
                        <field name="warehouse_id"/>
                        <field name="location_id" groups="stock.group_stock_multi_locations"/>
                        <field name="orderpoint_id"/>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_stock_low_alert_exception" model="ir.actions.act_window">
        <field name="name">Exceptions</field>
        <field name="res_model">stock.low.alert.exception</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
