<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_low_alert_responsible_list" model="ir.ui.view">
        <field name="name">stock.low.alert.responsible.list</field>
        <field name="model">stock.low.alert.responsible</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Alert responsibles">
                <field name="sequence" widget="handle"/>
                <field name="active" optional="hide"/>
                <field name="user_id"/>
                <field name="product_id" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="warehouse_id" optional="show"/>
                <field name="notification_mode"/>
            </list>
        </field>
    </record>
    <record id="view_stock_low_alert_responsible_form" model="ir.ui.view">
        <field name="name">stock.low.alert.responsible.form</field>
        <field name="model">stock.low.alert.responsible</field>
        <field name="arch" type="xml">
            <form string="Alert responsible">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="user_id"/>
                        <field name="notification_mode"/>
                    </group>
                    <group string="Scope">
                        <field name="product_id"/>
                        <field name="category_id"/>
                        <field name="warehouse_id"/>
                    </group>
                    <p class="text-muted">Rules are evaluated by sequence. Leave the scope empty to use the user as the global responsible.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_stock_low_alert_responsible" model="ir.actions.act_window">
        <field name="name">Responsibles</field>
        <field name="res_model">stock.low.alert.responsible</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
