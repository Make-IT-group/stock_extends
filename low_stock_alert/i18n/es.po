#. module: low_stock_alert
#: model:mail.template,body_html:low_stock_alert.mail_template_stock_low_alert
msgid "<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n                <p>Hello <t t-out=\"object.assigned_user_id.name or ''\"/>,</p>\n                <p>Low stock was detected for <strong><t t-out=\"object.product_id.display_name\"/></strong>.</p>\n                <table style=\"border-collapse: collapse;\">\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Current stock</strong></td><td><t t-out=\"object.stock_current\"/> <t t-out=\"object.uom_id.name or ''\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Minimum</strong></td><td><t t-out=\"object.min_qty\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Maximum</strong></td><td><t t-out=\"object.max_qty\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Warehouse</strong></td><td><t t-out=\"object.warehouse_id.display_name or ''\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Last purchase vendor</strong></td><td><t t-out=\"object.last_supplier_id.display_name or '-'\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Last purchase quantity</strong></td><td><t t-out=\"object.last_purchase_qty\"/></td></tr>\n                </table>\n                <p>Review alert <strong><t t-out=\"object.name\"/></strong> in Inventory / Reporting / Alerts.</p>\n            </div>"
msgstr "<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n                <p>Hola <t t-out=\"object.assigned_user_id.name or ''\"/>,</p>\n                <p>Se detectó stock bajo para <strong><t t-out=\"object.product_id.display_name\"/></strong>.</p>\n                <table style=\"border-collapse: collapse;\">\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Stock actual</strong></td><td><t t-out=\"object.stock_current\"/> <t t-out=\"object.uom_id.name or ''\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Mínimo</strong></td><td><t t-out=\"object.min_qty\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Máximo</strong></td><td><t t-out=\"object.max_qty\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Almacén</strong></td><td><t t-out=\"object.warehouse_id.display_name or ''\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Proveedor última compra</strong></td><td><t t-out=\"object.last_supplier_id.display_name or '-'\"/></td></tr>\n                    <tr><td style=\"padding:4px 12px 4px 0;\"><strong>Cantidad última compra</strong></td><td><t t-out=\"object.last_purchase_qty\"/></td></tr>\n                </table>\n                <p>Consulta la alerta <strong><t t-out=\"object.name\"/></strong> en Inventario / Reportes / Alertas.</p>\n            </div>"

