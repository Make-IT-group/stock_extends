<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_expiration_alert_company_rule" model="ir.rule">
        <field name="name">Stock expiration alerts by company</field>
        <field name="model_id" ref="model_stock_expiration_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="stock_expiration_alert_rule_company_rule" model="ir.rule">
        <field name="name">Stock expiration alert rules by company</field>
        <field name="model_id" ref="model_stock_expiration_alert_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="stock_expiration_alert_notification_company_rule" model="ir.rule">
        <field name="name">Stock expiration alert notifications by company</field>
        <field name="model_id" ref="model_stock_expiration_alert_notification"/>
        <field name="domain_force">[('alert_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
