<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_stock_expiration_alert" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.stock.expiration.alert</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Stock expiration alerts" name="stock_expiration_alert_settings">
                    <setting string="Enable stock expiration alerts" help="Enable or disable automatic expiration analysis for stock lots.">
                        <field name="stock_expiration_alert_enabled"/>
                    </setting>
                    <setting string="Notification channel" help="Channel used when a rule uses global settings." invisible="not stock_expiration_alert_enabled">
                        <field name="stock_expiration_alert_notification_mode"/>
                    </setting>
                    <setting string="Resend frequency" help="Minimum time between notifications while an alert remains open." invisible="not stock_expiration_alert_enabled">
                        <div class="content-group">
                            <field name="stock_expiration_alert_resend_hours" class="oe_inline"/>
                            <span class="ms-2">hours</span>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

