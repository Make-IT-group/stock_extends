<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_expiration_alert_search" model="ir.ui.view">
        <field name="name">stock.expiration.alert.search</field>
        <field name="model">stock.expiration.alert</field>
        <field name="arch" type="xml">
            <search string="Stock expiration alerts">
                <field name="name"/><field name="product_id"/><field name="lot_id"/>
                <field name="assigned_user_id"/><field name="warehouse_id"/><field name="location_id"/>
                <filter name="open" string="Open alerts" domain="[('state','=','open')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','open'),('days_remaining','&lt;',0)]"/>
                <filter name="my_alerts" string="My alerts" domain="[('assigned_user_id','=',uid)]"/>
                <separator/>
                <filter name="resolved" string="Resolved" domain="[('state','=','resolved')]"/>
                <filter name="ignored" string="Ignored" domain="[('state','=','ignored')]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter name="group_lot" string="Lot/Serial" context="{'group_by':'lot_id'}"/>
                    <filter name="group_user" string="Responsible" context="{'group_by':'assigned_user_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_expiration" string="Expiration month" context="{'group_by':'expiration_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_stock_expiration_alert_list" model="ir.ui.view">
        <field name="name">stock.expiration.alert.list</field>
        <field name="model">stock.expiration.alert</field>
        <field name="arch" type="xml">
            <list string="Stock expiration alerts" create="0" delete="0"
                  decoration-danger="state == 'open' and (days_remaining &lt; 0 or severity == 'critical')"
                  decoration-warning="state == 'open' and severity == 'warning' and days_remaining &gt;= 0"
                  decoration-info="state == 'open' and severity == 'info'"
                  decoration-muted="state != 'open'">
                <field name="name"/><field name="severity" widget="badge"/>
                <field name="product_id"/><field name="lot_id"/><field name="quantity"/>
                <field name="uom_id" optional="hide"/><field name="expiration_date"/>
                <field name="days_remaining"/><field name="assigned_user_id"/>
                <field name="warehouse_id" optional="show"/><field name="location_id" optional="show"/>
                <field name="notification_count" optional="show"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_stock_expiration_alert_form" model="ir.ui.view">
        <field name="name">stock.expiration.alert.form</field>
        <field name="model">stock.expiration.alert</field>
        <field name="arch" type="xml">
            <form string="Stock expiration alert" create="0" delete="0">
                <header>
                    <button name="action_send_notification" type="object" string="Send alert now" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_resolve" type="object" string="Mark as resolved" invisible="state != 'open'"/>
                    <button name="action_ignore" type="object" string="Ignore" invisible="state != 'open'"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state == 'open'" groups="stock.group_stock_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,resolved,ignored"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_related_alerts" type="object" class="oe_stat_button" icon="fa-link" invisible="related_alert_count == 0">
                            <field name="related_alert_count" widget="statinfo" string="Related"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="severity"/><field name="assigned_user_id"/><field name="rule_id"/><field name="company_id" groups="base.group_multi_company"/></group>
                        <group><field name="first_alert_date"/><field name="last_alert_date"/><field name="last_notification_date"/><field name="resolved_date" invisible="state == 'open'"/></group>
                    </group>
                    <group string="Expiring stock">
                        <group><field name="product_id"/><field name="lot_id"/><field name="quantity"/><field name="uom_id"/></group>
                        <group><field name="expiration_date"/><field name="days_remaining"/><field name="warehouse_id"/><field name="location_id"/></group>
                    </group>
                    <notebook>
                        <page string="Notification history">
                            <field name="notification_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="sent_at"/><field name="user_id"/><field name="channel"/>
                                    <field name="state" widget="badge"/><field name="activity_id" optional="show"/>
                                    <field name="email_to" optional="show"/><field name="error_message" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_stock_expiration_alert" model="ir.actions.act_window">
        <field name="name">Expiration Alerts</field>
        <field name="res_model">stock.expiration.alert</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_expiration_alert_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock expiration alerts found.</p>
            <p>Alerts are generated from positive stock quants whose tracked lots reach a configured expiration threshold.</p>
        </field>
    </record>
</odoo>

