<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_expiration_alert_rule_list" model="ir.ui.view">
        <field name="name">stock.expiration.alert.rule.list</field>
        <field name="model">stock.expiration.alert.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Expiration alert rules">
                <field name="sequence" widget="handle"/>
                <field name="active" optional="hide"/>
                <field name="name"/>
                <field name="product_id" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="warehouse_id" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="days_before_expiration"/>
                <field name="user_id"/>
                <field name="severity" widget="badge"/>
                <field name="notification_mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_stock_expiration_alert_rule_form" model="ir.ui.view">
        <field name="name">stock.expiration.alert.rule.form</field>
        <field name="model">stock.expiration.alert.rule</field>
        <field name="arch" type="xml">
            <form string="Expiration alert rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="days_before_expiration"/>
                            <field name="user_id"/>
                            <field name="severity"/>
                            <field name="notification_mode"/>
                        </group>
                    </group>
                    <group string="Scope">
                        <group><field name="product_id"/><field name="category_id"/></group>
                        <group><field name="warehouse_id"/><field name="location_id"/></group>
                    </group>
                    <p class="text-muted">Rules are evaluated by sequence. Empty scope fields act as wildcards. A selected location also covers its child locations.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_stock_expiration_alert_rule" model="ir.actions.act_window">
        <field name="name">Alert Rules</field>
        <field name="res_model">stock.expiration.alert.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
